OME_HOST_IP=REPLACE_WITH_HETZNER_PUBLIC_IPV4
OME_TLS_DOMAIN=rtc.nbmedia.live
# RTSP address WITHOUT the rtsp:// prefix, reached through WireGuard.
OME_ORIGIN_RTSP=10.77.0.2:554/REPLACE_WITH_UNREAL_RTSP_PATH
# Replace with the output of: openssl rand -hex 32
# Use the 64-character text itself as the HMAC key, not its decoded bytes.
OME_SIGNING_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
