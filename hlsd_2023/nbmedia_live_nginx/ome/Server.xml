<?xml version="1.0" encoding="UTF-8"?>
<Server version="8">
    <Name>nbmedia-webrtc</Name>
    <!-- "origin" permits local output profiles; input is pulled from Unreal. -->
    <Type>origin</Type>
    <IP>*</IP>
    <Modules>
        <P2P><Enable>false</Enable></P2P>
    </Modules>
    <Bind>
        <Providers>
            <RTSPC><WorkerCount>2</WorkerCount></RTSPC>
        </Providers>
        <Publishers>
            <WebRTC>
                <Signalling>
                    <!-- OME itself terminates TLS. No plaintext signaling port. -->
                    <TLSPort>443</TLSPort>
                    <WorkerCount>2</WorkerCount>
                </Signalling>
                <IceCandidates>
                    <IceCandidate>${env:OME_HOST_IP}:10000-10003/udp</IceCandidate>
                    <TcpRelay>${env:OME_HOST_IP}:3478</TcpRelay>
                    <TcpRelayForce>false</TcpRelayForce>
                    <TcpRelayWorkerCount>2</TcpRelayWorkerCount>
                </IceCandidates>
            </WebRTC>
        </Publishers>
    </Bind>
    <VirtualHosts>
        <VirtualHost>
            <Name>default</Name>
            <Host>
                <Names><Name>${env:OME_TLS_DOMAIN}</Name></Names>
                <TLS>
                    <CertPath>/etc/letsencrypt/live/${env:OME_TLS_DOMAIN}/cert.pem</CertPath>
                    <KeyPath>/etc/letsencrypt/live/${env:OME_TLS_DOMAIN}/privkey.pem</KeyPath>
                    <ChainCertPath>/etc/letsencrypt/live/${env:OME_TLS_DOMAIN}/chain.pem</ChainCertPath>
                </TLS>
            </Host>
            <SignedPolicy>
                <PolicyQueryKeyName>policy</PolicyQueryKeyName>
                <SignatureQueryKeyName>signature</SignatureQueryKeyName>
                <SecretKey>${env:OME_SIGNING_SECRET}</SecretKey>
                <Enables><Publishers>webrtc</Publishers></Enables>
            </SignedPolicy>
            <Origins>
                <Origin>
                    <!-- Repeat Origin blocks for additional explicitly mapped streams. -->
                    <Location>/live/ch1</Location>
                    <Pass>
                        <Scheme>rtsp</Scheme>
                        <Urls><Url>${env:OME_ORIGIN_RTSP}</Url></Urls>
                    </Pass>
                    <ForwardQueryParams>false</ForwardQueryParams>
                </Origin>
            </Origins>
            <Applications>
                <Application>
                    <Name>live</Name>
                    <Type>live</Type>
                    <OutputProfiles>
                        <OutputProfile>
                            <Name>webrtc</Name>
                            <OutputStreamName>${OriginStreamName}</OutputStreamName>
                            <Encodes>
                                <Video><Name>video</Name><Bypass>true</Bypass></Video>
                                <Audio>
                                    <Name>audio</Name>
                                    <Codec>opus</Codec>
                                    <Bitrate>64000</Bitrate>
                                    <Samplerate>48000</Samplerate>
                                    <Channel>2</Channel>
                                </Audio>
                            </Encodes>
                        </OutputProfile>
                    </OutputProfiles>
                    <Providers><RTSPPull /></Providers>
                    <Publishers>
                        <AppWorkerCount>1</AppWorkerCount>
                        <StreamWorkerCount>4</StreamWorkerCount>
                        <WebRTC>
                            <Rtx>true</Rtx>
                            <Ulpfec>false</Ulpfec>
                            <CreateDefaultPlaylist>true</CreateDefaultPlaylist>
                        </WebRTC>
                    </Publishers>
                </Application>
            </Applications>
        </VirtualHost>
    </VirtualHosts>
</Server>
